{
  "kind": "collectionType",
  "collectionName": "programadores",
  "info": {
    "singularName": "programador",
    "pluralName": "programadores",
    "displayName": "Programador"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombreCompleto": {
      "type": "string"
    },
    "especialidad": {
      "type": "string"
    },
    "descripcionBreve": {
      "type": "text"
    },
    "descripcionCompleta": {
      "type": "text"
    },
    "fotoPerfil": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "correoContacto": {
      "type": "email"
    },
    "github": {
      "type": "string"
    },
    "linkedin": {
      "type": "string"
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombreCompleto"
    },
    "proyectos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::proyecto.proyecto",
      "inversedBy": "programadors"
    }
  }
}
